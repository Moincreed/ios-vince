xnu: 0186 vince persistent console log on eMMC

Flush the vince_conlog RAM ring to the last 1 MiB of userdata every 5 s
(mmcrw=1 only, never under the HFS+ volume), in sweet's SWEETLOG format,
so the log can be pulled from recovery after a hang or panic.

diff --git a/bsd/dev/vince_mmc.c b/bsd/dev/vince_mmc.c
index 8df3fb7..203b111 100644
--- a/bsd/dev/vince_mmc.c
+++ b/bsd/dev/vince_mmc.c
@@ -32,6 +32,8 @@
 #include <miscfs/devfs/devfs.h>
 #include <kern/locks.h>
 #include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
 #include <pexpert/pexpert.h>
 #include <libkern/libkern.h>
 
@@ -44,6 +46,13 @@ extern void vince_input_start(void);
 /* bsd/dev/vince_ctl.c: clean halt when the shim asks (tools/vince_halt.py) */
 extern void vince_ctl_start(void);
 extern void vince_smd_start(void);
+/* osfmk/console/serial_console.c: RAM ring of everything the console prints */
+extern char vince_conlog[1 << 20];
+extern volatile uint64_t vince_conlog_pos;
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+static void vince_log_start(void);
 
 #define SDCC1_PHYS      0x07824000ul    /* MCI core; the SDHCI registers start at +0x900 */
 #define GCC_SDCC1_PHYS  0x01842000ul    /* SDCC1 BCR, then the apps RCG at +4 */
@@ -895,6 +904,7 @@ vince_mmc_init(void)
 	vm.ready = true;
 	printf("VINCE MMC: \"%s\" at sector 0x%llx, %llu MiB, %s, %s (8-bit HS 50 MHz, PIO)\n",
 	    want, vm.first, vm.nsect * SECTOR >> 20, fs, vm.rw ? "read-write" : "read-only");
+	vince_log_start();
 	sweet_sample_start();
