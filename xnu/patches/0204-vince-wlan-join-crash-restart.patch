xnu: 0204 vince Wi-Fi: management frames as before 0202; clean Pronto restart

Phone with 0202/0203: joins made the firmware assert at SET_LINK(POSTASSOC)
("ubsp_err.c:282:Signal Raised!(DDR mode)"), where 0201 had joined twice.
Keep management/control frames at their pre-0202 512 bytes (data frames
stay whole). The 0203 restart then reopened WCNSS_CTRL against the dead
firmware's still-OPENED half and jammed the FIFO (NV fragment 2 not sent):
close our halves before PAS SHUTDOWN and wait for the new firmware to
reset its half before opening.

diff --git a/bsd/dev/vince_smd.c b/bsd/dev/vince_smd.c
index b6479fa..8deac07 100644
--- a/bsd/dev/vince_smd.c
+++ b/bsd/dev/vince_smd.c
@@ -726,6 +726,8 @@ vp_phys(uint32_t pa, const uint8_t *src, uint32_t len)
 #define WC_NV_RSP       0x01000003u
 #define WC_NV_FRAG      3072u
 
+static bool vp_restarting;
+
 static int
 vp_ctrl(const uint8_t *nv, uint32_t nv_len)
 {
@@ -747,6 +749,19 @@ vp_ctrl(const uint8_t *nv, uint32_t nv_len)
 		return -1;
 	}
 	printf("VINCE PRONTO: WCNSS_CTRL appeared after %d ms\n", waited * 25);
+	if (vp_restarting) {
+		/*
+		 * 0204: after a restart the channel entry is the old one, its remote half still OPENED from the dead
+		 * firmware; wait until the new firmware resets it (CLOSED or OPENING) before opening, or the first
+		 * packets go into a FIFO nobody reads (0203 on the phone: NV fragment 2 not sent).
+		 */
+		int t;
+		for (t = 0; t < 400 && rd32(c.info + I_HALF + I_STATE) == ST_OPENED; t++) {
+			vince_smd_sleep(25);
+		}
+		printf("VINCE PRONTO: restart: firmware half of WCNSS_CTRL is %u after %d ms\n",
+		    rd32(c.info + I_HALF + I_STATE), t * 25);
+	}
 	for (int i = 0; i < 100 && (r = vince_smd_open(&c)) == -1; i++) {
 		vince_smd_sleep(20);
 	}
@@ -1301,6 +1316,14 @@ vince_pronto_boot_ex(bool restart)
 	 * stopped (PAS SHUTDOWN) and the firmware reloaded for the next.
 	 */
 	if (restart) {
+		static const char *const chans[] = { "WCNSS_CTRL", "WLAN_CTRL", "APPS_RIVA_BT_CMD", "APPS_RIVA_BT_ACL" };
+		for (unsigned i = 0; i < sizeof(chans) / sizeof(chans[0]); i++) {
+			struct vsmd_ch ch;
+			if (vince_smd_find(chans[i], &ch)) {
+				vs_set_state(&ch, ST_CLOSED);   /* our side closed: the new firmware starts the handshake over */
+			}
+		}
+		vp_restarting = true;
 		st = vp_scm(2, 6, 1, VP_PAS_ID, 0, 0, &res);    /* PAS SHUTDOWN of the running firmware */
 		printf("VINCE PRONTO: restart: SHUTDOWN status %lld result %llu, setup mode %d\n", st, res, vp_good_mode);
 		vince_smd_sleep(200);
@@ -1412,6 +1435,7 @@ out:
 	if (nv) {
 		kfree_data(nv, ((h.nv_len + 511) & ~511u) + 512);
 	}
+	vp_restarting = false;
 	return result;
 }
 
diff --git a/bsd/dev/vince_wlan_dxe.c b/bsd/dev/vince_wlan_dxe.c
index e209d24..a020b31 100755
--- a/bsd/dev/vince_wlan_dxe.c
+++ b/bsd/dev/vince_wlan_dxe.c
@@ -514,6 +514,13 @@ note_frame(const volatile uint8_t *buf, uint32_t hdr_off, uint32_t len, uint32_t
 {
 	static uint8_t f[VD_Q_FRAME_MAX];      /* static: 2400 bytes; vd_poll runs on the Wi-Fi driver thread */
 	uint32_t n = len < sizeof(f) ? len : (uint32_t)sizeof(f);
+	/*
+	 * 0204: management and control frames as before 0202 (first 512 bytes); only data frames whole. With 0202 a
+	 * join on the phone made the firmware assert at SET_LINK(POSTASSOC) twice, where 0201 had joined.
+	 */
+	if (n > 512 && (buf[hdr_off] & 0x0c) != 0x08) {
+		n = 512;
+	}
 	uint32_t fc, type, sub;
 	bool is_beacon;
 	const uint8_t *bssid;
