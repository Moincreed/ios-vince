xnu: 0188 vince boot-args vincefb_lw/vincefb_lh (drawn display size)

Let iOS draw a smaller screen (e.g. iPhone XR 828x1792 @2x) that the
framebuffer scales to the 1080x2160 panel; touch maps through the same size.

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index f4a57bc..60c96ca 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -207,6 +207,18 @@ AppleCLCD::start(IOService *provider)
 		fLogicalW = SWEET_FB_LOGICAL_W;
 		fLogicalH = SWEET_FB_LOGICAL_H;
 	}
+#if defined(ARM64_BOARD_CONFIG_VINCE)
+	/*
+	 * vincefb_lw / vincefb_lh: the size iOS draws (e.g. 828x1792, an iPhone XR screen at @2x, with the ADT built by
+	 * mkadt_vince.py --xr); scaled to the panel below. Fewer pixels for CoreAnimation's CPU renderer.
+	 */
+	uint32_t lw = 0, lh = 0;
+	if (!native && PE_parse_boot_argn("vincefb_lw", &lw, sizeof(lw)) && PE_parse_boot_argn("vincefb_lh", &lh, sizeof(lh)) &&
+	    lw >= 320 && lh >= 480 && lw <= 2048 && lh <= 4096) {
+		fLogicalW = lw;
+		fLogicalH = lh;
+	}
+#endif
 	fOffX = (int32_t)(fLogicalW - fWidth) / 2;
 	fOffY = (int32_t)(fLogicalH - fHeight) / 2;
 	fShadowW = fWidth;
