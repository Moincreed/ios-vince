xnu: 0208 vince Wi-Fi: receive multicast; tell wifid after a restart

On the phone every received frame in every log was unicast to us: the
firmware passed no multicast (no IPv6 router advertisements, so no IPv6;
no mDNS). Send WCN36XX_HAL_8023_MULTICAST_LIST_REQ with an empty list after
each join - all multicast received (mainline wcn36xx_smd_set_mc_list).
After a Pronto restart also post POWER_CHANGED and SCAN_DONE so wifid
joins again without waiting.

diff --git a/bsd/dev/vince_wlan.c b/bsd/dev/vince_wlan.c
index a94737b..b78494d 100755
--- a/bsd/dev/vince_wlan.c
+++ b/bsd/dev/vince_wlan.c
@@ -1263,6 +1263,7 @@ vui_assoc(const struct vui_assoc *a, int stage)
 			return 0;
 		}
 	}
+	(void)va_allow_multicast();
 	lck_mtx_lock(vui_lk);
 	vui_i.state = VUI_S_RUN;
 	vui_i.ssid_len = a->ssid_len;
@@ -1444,6 +1445,12 @@ vui_loop(int stage)
 			}
 			vif_ui_up();
 			vif_a80211_event(55, NULL, 0);          /* APPLE80211_M_DRIVER_AVAILABLE */
+			/*
+			 * 0208: the restart's scan just found the networks around; tell wifid at once (power, scan done) so its
+			 * auto-join runs now - on the phone it waited well after the driver was back before joining again.
+			 */
+			vif_a80211_event(1, NULL, 0);           /* APPLE80211_M_POWER_CHANGED */
+			vif_a80211_event(10, NULL, 0);          /* APPLE80211_M_SCAN_DONE */
 		}
 	}
 }
