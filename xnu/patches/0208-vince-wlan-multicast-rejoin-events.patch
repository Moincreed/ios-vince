--- a/bsd/dev/vince_wlan_assoc.c
+++ b/bsd/dev/vince_wlan_assoc.c
@@ -627,6 +627,34 @@ int va_install_ptk(const uint8_t tk[16])
 	return e;
 }
 
+/*
+ * 0208: WCN36XX_HAL_8023_MULTICAST_LIST_REQ (157) with an empty list for the joined BSS - "an empty list means all
+ * mc traffic will be received" (mainline wcn36xx_smd_set_mc_list). Without it the firmware passed no multicast at
+ * all (no IPv6 router advertisements, no mDNS: on the phone every received frame was unicast to us).
+ */
+int va_allow_multicast(void);
+
+int
+va_allow_multicast(void)
+{
+	static struct __attribute__((packed)) {
+		uint8_t data_offset;
+		uint32_t mc_addr_count;
+		uint8_t mc_addr[240][6];
+		uint8_t bss_index;
+	} b;
+	uint32_t status = 0;
+
+	if (s_last.bss_index == 0xff) {
+		return -1;
+	}
+	memset(&b, 0, sizeof(b));
+	b.bss_index = s_last.bss_index;
+	int e = vw_cmd(157, &b, sizeof(b), &status);
+	printf("VINCE WLAN: multicast list (all multicast) for bss %u: %d status %u\n", s_last.bss_index, e, status);
+	return e;
+}
+
 int va_install_gtk(uint8_t keyid, const uint8_t gtk[16])
