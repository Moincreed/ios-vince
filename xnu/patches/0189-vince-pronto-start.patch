+/*
+ * Read n sectors at partition-relative sector rel of GPT partition name into dst (normal kernel memory).
+ * For vince_smd.c (Pronto firmware kept in the unused tail of "boot"). Read-only; vm.first / vm.nsect are kept.
+ */
+int vince_mmc_part_read(const char *name, uint64_t rel, uint32_t n, void *dst);
+
+int
+vince_mmc_part_read(const char *name, uint64_t rel, uint32_t n, void *dst)
+{
+	if (!vm.ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&vince_mmc_lock);
+	uint64_t first = vm.first, nsect = vm.nsect;
+	int error = mmc_find_partition(name);
+	uint64_t pfirst = vm.first, pn = vm.nsect;
+	vm.first = first;
+	vm.nsect = nsect;
+	if (!error && (rel >= pn || n > pn - rel)) {
+		error = EINVAL;
+	}
+	for (uint32_t done = 0; !error && done < n;) {
+		uint32_t k = MIN(n - done, MAX_SECTORS);
+		error = mmc_read_sectors(pfirst + rel + done, k);
+		if (!error) {
+			memcpy((uint8_t *)dst + (uint64_t)done * SECTOR, vince_mmc_bounce, (size_t)k * SECTOR);
+		}
+		done += k;
+	}
+	lck_mtx_unlock(&vince_mmc_lock);
+	return error;
+}
